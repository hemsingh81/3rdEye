<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- STORY-13: bumped to a versioned Windows SDK target so
         Windows.Devices.Geolocation (a WinRT API) is available —
         LocationClient.cs needs it. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>3rdEyeAgent</AssemblyName>
    <!-- Lets this compile-check on a non-Windows CI runner / dev machine; has no effect on a real Windows build. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
